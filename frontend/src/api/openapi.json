{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RunRecord": {
        "description": "One row of the append-only ``runs`` table, keyed ``(market, session)``.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "market": {
            "title": "Market",
            "type": "string"
          },
          "session": {
            "format": "date",
            "title": "Session",
            "type": "string"
          },
          "status": {
            "enum": [
              "published",
              "quarantined"
            ],
            "title": "Status",
            "type": "string"
          },
          "symbols_enumerated": {
            "title": "Symbols Enumerated",
            "type": "integer"
          },
          "symbols_resolved": {
            "title": "Symbols Resolved",
            "type": "integer"
          }
        },
        "required": [
          "market",
          "session",
          "status",
          "symbols_enumerated",
          "symbols_resolved",
          "created_at"
        ],
        "title": "RunRecord",
        "type": "object"
      },
      "RunsResponse": {
        "description": "Run records for one market, newest first.\n\n``latest`` is the last *published* run \u2014 the as-of session the tab renders.\nIt is ``None`` when no run has published yet, which the tab shows as an\nexplicit empty state rather than a blank or a fabricated date.",
        "properties": {
          "latest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunRecord"
              },
              {
                "type": "null"
              }
            ]
          },
          "market": {
            "title": "Market",
            "type": "string"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunRecord"
            },
            "title": "Runs",
            "type": "array"
          },
          "universe_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Universe Size"
          }
        },
        "required": [
          "market",
          "latest",
          "runs",
          "universe_size"
        ],
        "title": "RunsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Qullamaggie Screening Dashboard",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/runs/{market}": {
      "get": {
        "operationId": "get_runs_api_runs__market__get",
        "parameters": [
          {
            "in": "path",
            "name": "market",
            "required": true,
            "schema": {
              "title": "Market",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Runs"
      }
    }
  }
}
