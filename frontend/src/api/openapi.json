            "title": "Is New",
            "type": "boolean"
          },
          "raw_return": {
            "title": "Raw Return",
            "type": "number"
          },
          "rs_pctile": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rs Pctile"
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector"
          },
          "surge": {
            "title": "Surge",
            "type": "boolean"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier"
          }
