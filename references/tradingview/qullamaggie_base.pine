//@version=6
// Qullamägi breakout/continuation base detector — for TradingView's Pine Screener.
//
// A port of backend/screener/detection.py + score.py, for running the app's setup
// detection over a TradingView watchlist. Read references/tradingview-screener-setup.md
// first — this script is layer 3 of a five-layer recipe and is close to useless without
// layer 2 (the watchlist that stands in for the decile gate).
//
// Every constant's provenance is references/qullamaggie-replay-findings.md, cited inline.
// Deviations from the app are marked DEVIATION and carry their reason.
//
// Usage: save → add to favourites → Pine Screener → source = your leaders watchlist →
// filter Detection = 1 → sort by Stars descending. Daily timeframe.
//
// The plots are screener columns, not a chart. On a chart they overlap nonsensically
// (stars and dollar prices on one scale); that is expected and does not matter.

indicator("Qullamägi base — Pine Screener", overlay = false, max_bars_back = 300)

// ── inputs ────────────────────────────────────────────────────────────────────────
adrLen    = input.int(20,     "ADR length",                    group = "Detection")
tightMult = input.float(2.0,  "Cluster max width, in ADR",     group = "Detection")
baseMax   = input.int(45,     "Base max bars",                 group = "Detection")
minBase   = input.int(3,      "Base min bars",                 group = "Detection")
catch10   = input.float(1.0,  "Catch-up: close-SMA10 <= n·ADR",group = "Detection")
catch20   = input.float(2.0,  "Catch-up: close-SMA20 <= n·ADR",group = "Detection")
minHist   = input.int(80,     "Min bars of history",           group = "Detection")

tightK    = input.int(5,      "Tightness point: cluster_k >=", group = "Rubric v2")
adrFloor  = input.float(5.0,  "ADR point: ADR% >=",            group = "Rubric v2")
churnLo   = input.float(0.30, "Orderliness band, low",         group = "Rubric v2")
churnHi   = input.float(0.60, "Orderliness band, high",        group = "Rubric v2")
dryupMax  = input.float(0.95, "Volume point: dry-up <=",       group = "Rubric v2")

stopAdr   = input.float(0.345,"Stop, in ADR below trigger",    group = "Order")

// ── ADR ───────────────────────────────────────────────────────────────────────────
// ADR% = SMA20(high/low - 1) x 100. Identical to TradingView's native "Volatility
// Month" screener field, so the hard floor belongs in layer 1, not here.
// Intraday-range only — it excludes gaps, so a habitual gapper screens lower than it
// really moves. Immaterial for flags; it would matter for EPs, which are out of scope.
adrPct = 100.0 * (ta.sma(high / low, adrLen) - 1.0)
adrAbs = close * adrPct / 100.0
adrOk  = adrAbs > 0

// ── liquidity, as a column ────────────────────────────────────────────────────────
// universe.py: median of unadjusted close x volume over the trailing 20 bars.
// Reported here only so the layer-1 cut is visible; layer 1 already applied it, and
// TradingView cannot reproduce the 0.8x hysteresis band (see the setup doc).
liqM = ta.median(close * volume, 20) / 1e6

// ── the cluster ───────────────────────────────────────────────────────────────────
// detection._find_cluster: the LARGEST trailing k in [3, 7] whose range sits under
// tightMult x ADR. Unrolled rather than looped because ta.highest needs a fixed length;
// K_MIN/K_MAX are therefore fixed at 3..7 and are not inputs.
//
// DEVIATION: the app holds TIGHT_MULT = 1.5 and findings §3a recommends leaving it
// there. Default here is 2.0. Reason: 113 of the 171 cluster misses were "marginal"
// (tightest window <= 2.0 ADR, median 1.85 against a 1.5 gate) and 148 of 171 were
// FRESH entries, not re-entries. The app cannot widen because precision is unmeasurable
// (§7's calibration rule); a human reading charts prices that cost visually in seconds.
// Read Cluster ADR as a quality column. If nearly everything over 1.5 gets declined,
// set this back to 1.5 — that is the honest test and it is cheap to run.
hh3 = ta.highest(high, 3)
ll3 = ta.lowest(low, 3)
hh4 = ta.highest(high, 4)
ll4 = ta.lowest(low, 4)
hh5 = ta.highest(high, 5)
ll5 = ta.lowest(low, 5)
hh6 = ta.highest(high, 6)
ll6 = ta.lowest(low, 6)
hh7 = ta.highest(high, 7)
ll7 = ta.lowest(low, 7)

r3 = adrOk ? (hh3 - ll3) / adrAbs : na
r4 = adrOk ? (hh4 - ll4) / adrAbs : na
r5 = adrOk ? (hh5 - ll5) / adrAbs : na
r6 = adrOk ? (hh6 - ll6) / adrAbs : na
r7 = adrOk ? (hh7 - ll7) / adrAbs : na

clusterK = not adrOk ? 0 :
   r7 <= tightMult ? 7 :
   r6 <= tightMult ? 6 :
   r5 <= tightMult ? 5 :
   r4 <= tightMult ? 4 :
   r3 <= tightMult ? 3 : 0

clusterHigh = clusterK == 7 ? hh7 : clusterK == 6 ? hh6 : clusterK == 5 ? hh5 : clusterK == 4 ? hh4 : clusterK == 3 ? hh3 : na
clusterLow  = clusterK == 7 ? ll7 : clusterK == 6 ? ll6 : clusterK == 5 ? ll5 : clusterK == 4 ? ll4 : clusterK == 3 ? ll3 : na
clusterAdr  = clusterK == 7 ? r7  : clusterK == 6 ? r6  : clusterK == 5 ? r5  : clusterK == 4 ? r4  : clusterK == 3 ? r3  : na

// detection.cluster_min_range_adr — the tightest trailing 3-7 window REGARDLESS of the
// threshold. A read-only diagnostic that changes no verdict (findings §3a): it tells you
// by how much a non-detection missed, so a rejected name is legible rather than silent.
minRangeAdr = adrOk ? math.min(math.min(math.min(r3, r4), math.min(r5, r6)), r7) : na

// ── catch-up ──────────────────────────────────────────────────────────────────────
// "the 10-day and 20-day catch up to price during the consolidation" — one-sided: it
// tests that price has not run away ABOVE the MA. He prefers 20-day-based setups over
// 10-day ones ("I never trust the 10-day ones"), which is why the 20 gets the wider band.
sma10 = ta.sma(close, 10)
sma20 = ta.sma(close, 20)
caughtUp = adrOk and (close - sma10 <= catch10 * adrAbs) and (close - sma20 <= catch20 * adrAbs)

// MA support dimension: SMA20 rising, sign-only (X[t] > X[t-5]), per score.py.
sma20Rising = sma20 > sma20[5]

// ── the base ──────────────────────────────────────────────────────────────────────
// DEVIATION (approximation): the app finds the best low->high run-up over windows of
// 21/42/63/126 bars and starts the base at that window's peak, capped at 45 bars. Pine
// gets a proxy — bars since the 45-bar high. It feeds Base length, which is weighted x0
// in rubric v2, so the approximation costs nothing in the score. It does still set the
// window that Orderliness and dry-up are measured over.
baseLen = math.max(1, math.min(baseMax, 1 - ta.highestbars(high, baseMax)))

sumRng = 0.0
bHigh  = high
bLow   = low
for i = 0 to baseLen - 1
    sumRng += high[i] - low[i]
    bHigh  := math.max(bHigh, high[i])
    bLow   := math.min(bLow, low[i])

baseRange = bHigh - bLow
// churn/L per detection.py: (sum of daily ranges / base range) / base_len.
churnL = baseRange > 0 ? (sumRng / baseRange) / baseLen : na

// Volume dry-up: base volume against the 50 bars before the base.
// DEVIATION: means, where the app uses medians (Pine has no variable-length median).
sumVolBase = 0.0
for i = 0 to baseLen - 1
    sumVolBase += volume[i]
sumVolPrior = 0.0
for i = baseLen to baseLen + 49
    sumVolPrior += volume[i]
meanVolBase  = sumVolBase / baseLen
meanVolPrior = sumVolPrior / 50.0
dryup = meanVolPrior > 0 ? meanVolBase / meanVolPrior : na

// ── the verdict ───────────────────────────────────────────────────────────────────
hasHistory  = bar_index >= minHist
isDetection = hasHistory and adrOk and clusterK > 0 and caughtUp and baseLen >= minBase

// The trigger IS the cluster's max high, by identity. The trendline never sets it —
// the line visualises tightness and hangs the alert, nothing more. Equivalently: a
// break is today's close above the last k sessions' high.
trigger = isDetection ? clusterHigh : na
distAdr = isDetection ? (trigger - close) / adrAbs : na

// The stop convention, findings §6 finding 1 — measured over 649 executed entries at a
// median of 0.345 ADR (p25 0.238, p75 0.490, 98.15% at or under 1.0 ADR). The cluster-low
// stop this replaced ran a median of 1.28 ADR, roughly four times wider than the stop he
// actually places. Ranking is untouched by it: the star score never reads the stop.
stopPx = isDetection ? trigger - stopAdr * (adrPct / 100.0) * trigger : na

brk = isDetection and not na(trigger[1]) and close > trigger[1]

// ── rubric v2 (score.RUBRIC_VERSION = 2, PRD #138) ────────────────────────────────
// Weights come from the ORDERING of the measured selection gaps in findings §5b, never
// their magnitude: ADR +29.4pp and Tightness +20.8pp are the two sharp selectors and take
// x2; Orderliness (-9.1pp) was demoted x2->x1; Base length (-13.4pp, the largest wrong-way
// gap) is worth x0 and is kept visible so a reader sees it measured and worth nothing.
//
// Two dimensions are not computable here:
//   Prior move — cross-sectional. Granted true by construction, exactly as in the app:
//     every detection cleared the decile gate, which for this script is the watchlist.
//     It is 100% in every group the study can build — documentation, never discrimination.
//   Sector — no sector-share data in Pine. Left unscored, so the automatic ceiling is
//     8 of 9 points; add the point by eye when the theme confirms.
pTight = clusterK >= tightK ? 2 : 0
pAdr   = adrPct >= adrFloor ? 2 : 0
pOrder = not na(churnL) and churnL >= churnLo and churnL <= churnHi ? 1 : 0
pPrior = 1
pMa    = sma20Rising ? 1 : 0
pVol   = not na(dryup) and dryup <= dryupMax ? 1 : 0
pBase  = 0  // x0 by measurement, kept as a visible row

float points = isDetection ? pTight + pAdr + pOrder + pPrior + pMa + pVol + pBase : na
float stars  = points / 2.0

// NOTE: the rubric ranks by resemblance to his revealed SELECTION, not by expected
// return. Findings §5a regressed every testable dimension against MFE and found nothing:
// the largest correlation is MA support at -0.158, pointing the wrong way, and four of six
// are negative. There is no return claim anywhere in this score.

// ── screener columns ──────────────────────────────────────────────────────────────
plot(isDetection ? 1 : 0, "Detection")
plot(stars,                "Stars")
plot(points,               "Points (of 8 auto)")
plot(adrPct,               "ADR %")
plot(clusterK,             "Cluster k")
plot(clusterAdr,           "Cluster ADR")
plot(minRangeAdr,          "Min range ADR")
plot(distAdr,              "Dist to trigger, ADR")
plot(trigger,              "Trigger")
plot(stopPx,               "Stop")
plot(baseLen,              "Base len")
plot(churnL,               "Churn/L")
plot(dryup,                "Dry-up")
plot(liqM,                 "Liq $M (20d med)")
plot(brk ? 1 : 0,          "Break today")
plot(caughtUp ? 1 : 0,     "Catch-up")

alertcondition(brk, "Break", "Close above yesterday's trigger")
